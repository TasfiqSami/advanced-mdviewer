# Application
NODE_ENV=production
PORT=3000
# Public HTTPS origin for this app. Also added to the trusted-origin allowlist.
APP_URL=https://markdown.example.com
OWNER_USERNAME=syxlor

# Authentication
# Required in production: choose a private 6-12 digit PIN (not a common/default PIN).
APP_PIN=
# Required: use a unique password with at least 12 characters.
OWNER_PASSWORD=replace-with-a-unique-password-at-least-12-characters
# Required in production: generate separate random values of at least 32 characters.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
OWNER_RECOVERY_KEY=replace-with-a-different-random-recovery-key-at-least-32-characters

# Database (this project currently uses SQLite, not Neon/PostgreSQL).
# Keep the database on a persistent host volume and back it up.
DATABASE_PATH=./data/syxlor.db

# Upload storage (must also be on persistent host storage).
STORAGE_PATH=./storage
MAX_UPLOAD_MB=20
STORAGE_QUOTA_GB=10

# Security / reverse proxy
# Comma-separated additional exact origins, if needed. APP_URL is included automatically.
TRUSTED_ORIGINS=
# Only set trusted proxy IPs if your hosting provider documents the proxy addresses.
TRUSTED_PROXY_IPS=
